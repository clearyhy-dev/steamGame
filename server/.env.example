# Server
PORT=8080
NODE_ENV=development

# JWT
JWT_SECRET=replace_me_with_long_random_secret
JWT_EXPIRES_IN=30d
JWT_ISSUER=steamgame-api

# Dual backend: GCP Auth (Steam OpenID + introspect) + Vultr business API
AUTH_ON_GCP=true
AUTH_SERVICE_URL=https://steam-game-api-r7vmg7elga-as.a.run.app
AUTH_INTROSPECT_SECRET=replace_me_shared_secret_for_vultr_to_gcp

# Steam OpenID (OpenID 2.0). STEAM_API_KEY may be omitted if set in Admin → Settings → 运行时 (Firestore system_config/runtime).
STEAM_API_KEY=replace_me
STEAM_REALM=http://localhost:8080
STEAM_RETURN_URL=http://localhost:8080/auth/steam/callback
# backward compatible (optional):
# STEAM_OPENID_REALM=http://localhost:8080
# STEAM_OPENID_RETURN_URL=http://localhost:8080/auth/steam/callback

# Deep link scheme (must be registered in App)
APP_DEEP_LINK_SCHEME=myapp
APP_DEEP_LINK_SUCCESS_HOST=auth
APP_DEEP_LINK_FAIL_HOST=auth
# backward compatible (optional):
# APP_DEEPLINK_SCHEME=myapp

# Public base URL used for deep link and return_to (defaults to http://localhost:8080 if unset; overridable in Firestore)
APP_BASE_URL=http://localhost:8080

# Hints for mobile app (served in GET /api/config; also overridable in Firestore)
APP_CONNECT_TIMEOUT_SEC=15
APP_RECEIVE_TIMEOUT_SEC=90

# Firestore
FIREBASE_PROJECT_ID=replace_me
# 本地若 Firestore gRPC 超时（ETIMEDOUT），可尝试改为 true 走 REST
# FIRESTORE_PREFER_REST=true
# Local dev: set service account json path.
# Cloud Run: prefer default service account (ADC), this can be left empty.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# Steam Web API timeout (ms)
STEAM_HTTP_TIMEOUT_MS=8000

# 全局后台任务（定时 cron、视频 worker、管理端「立即运行」）。生产停费用 false
# BACKGROUND_WORKERS_ENABLED=false

# 元数据存储：vultr_sqlite（默认，停 Firestore 计费）| firestore
DATA_STORE=vultr_sqlite
SQLITE_API_URL=http://YOUR_VULTR_IP:8090
SQLITE_API_SECRET=change-me-long-random
# 迁移后建议关闭请求日志写入（默认 vultr 模式已关）
# REQUEST_LOG_ENABLED=false

# Steam auto sync worker (backend only)
STEAM_AUTO_SYNC_ENABLED=false
STEAM_AUTO_SYNC_INTERVAL_MS=3600000
STEAM_AUTO_SYNC_BATCH_SIZE=200
STEAM_AUTO_SYNC_DELAY_MS=120

# Optional: Cloud Scheduler calls POST /api/internal/cron/* with header X-Cron-Secret
# CRON_SECRET=
#
# 折扣分桶：object_storage = Vultr MinIO（DATA_STORE=vultr_sqlite 时必填）；firestore 仅回退 GCP 时用
DISCOUNT_OFFERS_PERSISTENCE=object_storage

# 对象存储：默认 S3 兼容（Vultr MinIO / R2），不再依赖 GCS
CACHE_UPLOAD_BACKEND=s3
# Vultr MinIO（deploy/vultr/setup.sh 安装后见 /opt/steamgame-data/.env）
# S3_ENDPOINT=http://YOUR_VULTR_IP:9000
# S3_ACCESS_KEY_ID=steamminio
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=steamgame
# PUBLIC_CACHE_CDN_BASE=http://YOUR_VULTR_IP:9000/steamgame
# REDIS_URL=redis://:REDIS_PASSWORD@YOUR_VULTR_IP:6379

# 仅当 CACHE_UPLOAD_BACKEND=gcs 时使用：
# GCS_CACHE_BUCKET=run-sources-steamdeal-asia-southeast1
# PUBLIC_CACHE_CDN_BASE=https://storage.googleapis.com/run-sources-steamdeal-asia-southeast1
# VIDEO_GCS_BUCKET=
# Cloudflare R2（也可设 R2_*，与 S3_* 等价）
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_CACHE_BUCKET=
# Optional: full HTTPS origin for cache/*.json (no trailing slash); served to app via GET /api/config as publicCacheCdnBase
# PUBLIC_CACHE_CDN_BASE=https://storage.googleapis.com/your-bucket

# 可选：Redis URL，cacheService 用其跨 Cloud Run 部署保留热点键（TTL 内）；不设则仅用进程内 node-cache
# REDIS_URL=redis://default:xxx@xxx.upstash.io:6379

# 折扣「今日已同步」日历日（Admin 筛选、计划任务跳过已同步）；默认 Asia/Shanghai
DEAL_SYNC_PRICE_DAY_TZ=Asia/Shanghai

# Video pipeline (overridable in Admin → Settings → 运行时)
# VIDEO_GCS_BUCKET=
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# YTDLP_PATH=yt-dlp
# VIDEO_TEMP_DIR=
# VIDEO_MAX_DURATION_SEC=180
# VIDEO_TRIM_SEC=30
# VIDEO_SIGNED_URL_MINUTES=60
# VIDEO_WORKER_INTERVAL_MS=10000

# Pro wishlist price alert emails (SMTP)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=alerts@example.com
# MAIL_FROM_NAME=Steam Game Deals

